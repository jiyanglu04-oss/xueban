# Windows 批处理和 PowerShell 脚本必须是 CRLF，否则在某些环境下无法执行
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 代码文件统一 LF，避免跨平台 diff 噪音
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# 二进制文件不要做任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
*.zip  binary
